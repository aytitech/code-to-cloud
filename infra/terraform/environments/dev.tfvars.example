# Dev environment variables
# Copy this file to dev.tfvars and fill in your values.
# Do not commit dev.tfvars - it may contain sensitive values.
# Secrets (hetzner_token, cloudflare_token, ssh_public_key) should be set
# as environment variables: TF_VAR_hetzner_token, etc.

environment        = "dev"
server_type        = "cx22"
location           = "nbg1"
cloudflare_zone_id = "YOUR_CLOUDFLARE_ZONE_ID"
domain             = "yourdomain.xyz"
